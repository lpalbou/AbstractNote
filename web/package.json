{
  "name": "@abstractframework/note",
  "version": "0.1.0",
  "description": "AbstractNote web app: capture notes, explore what they connect, and remember how your understanding changed.",
  "type": "module",
  "author": "Laurent-Philippe Albou",
  "license": "MIT",
  "keywords": [
    "abstractframework",
    "notes",
    "memory",
    "knowledge-graph",
    "gateway"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/lpalbou/AbstractNote.git",
    "directory": "web"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "abstractnote-web": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "mock": "node ./mock/server.mjs",
    "build": "tsc && vite build && node scripts/check_relative_urls.mjs dist",
    "preview": "vite preview",
    "start": "node ./bin/cli.js",
    "test": "vitest run",
    "screens": "node scripts/screens.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@abstractframework/app-server": "^0.1.12",
    "@abstractframework/panel-chat": "^0.4.1",
    "@abstractframework/ui-kit": "^0.8.7",
    "d3-force": "^3.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "^1.61.1",
    "typescript": "^5.3.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
