{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tsbuild"
  },
  "include": ["vite.config.ts"]
}
