        "functionName": "transform",
        "codeBody": "CANDIDATES_PER_MENTION = 3\nCHANGED_LABEL = 'Understood differently since this note was read (ideas this note relies on, as known on its date; read the note again in their light, and answer as before where its meaning does not change):'\nCLAIMS_PER_CANDIDATE = 3\nEVIDENCE_CHARS = 200\nKNOWN_NAMES = 15\nKNOWN_PREDICATES = 15\nKNOWN_SLOTS = 30\nLATER_CLAIMS_PER_CANDIDATE = 12\nLATER_LABEL = \"LATER (recorded after this note's date — do not restate; say if a statement is an earlier state of one of these):\"\nLATER_SUMMARIES_PER_CANDIDATE = 2\nLINK_MENTIONS_PER_CALL = 15\nOPEN_TASKS = 8\nPREVIOUS_EXTRACT_LABEL = 'This note was previously understood as (its own earlier reading; a statement this text makes again keeps the same subject and the same predicate as written here):'\nPREVIOUS_LABEL = 'This note was previously understood as (its own earlier reading, before what the notebook knows; a statement this note still makes is the same statement as its previous one: name it by its P number with `same_statement_as_previous`):'\nSIMILAR_NOTES = 5\nSUMMARY_CHARS = 240\nTOPICS = 50\nWITHDRAWN_LABEL = '  withdrawn by you — do not restate (you said these are wrong):'\ndef clip(text, limit):\n    \"\"\"One line of at most ``limit`` characters, cut at a word boundary (packet views only).\"\"\"\n    s = ' '.join(str(text or '').split())\n    if len(s) <= limit:\n        return s\n    cut = s[:limit].rsplit(' ', 1)[0]\n    return (cut or s[:limit]).rstrip(' ,;:') + '…'\ndef note_envelope():\n    \"\"\"The user message's head ``<runtime_metadata>`` envelope: the SAME bytes for every call.\n\n    The runtime keeps an envelope that is already at the head of a message byte for byte and\n    stamps a fresh per-second one only on a message without one; a per-call timestamp there would\n    end the shared prefix after a few tokens. The note's own time and id go at the END of the\n    message (``note_header``), where they cannot break the cached prefix.\"\"\"\n    return '<runtime_metadata>{\"time\": \"the note\\'s own date is on the last line of this message\"}</runtime_metadata>'\ndef filing_packet(note_id, occurred_at, title, text, similar, revisits, topics):\n    \"\"\"The dynamic half of the quick filing prompt: ``{envelope, title, text, context, header}``.\"\"\"\n    lines = []\n    sims = []\n    for s in (similar or [])[:SIMILAR_NOTES]:\n        if isinstance(s, dict) and (s.get('title') or s.get('note_id')):\n            sims.append('“' + clip(s.get('title') or 'untitled', 100) + '” (' + str(s.get('occurred_at') or '')[:10] + ')')\n    if sims:\n        lines.append('Similar earlier notes: ' + '; '.join(sims) + '.')\n    days = [str(r.get('occurred_at') or '')[:10] for r in revisits or [] if isinstance(r, dict) and r.get('occurred_at')]\n    if days:\n        lines.append('Earlier notes with the same words: ' + ', '.join(days[:5]) + '.')\n    shown = [str(t) for t in topics or [] if str(t).strip()][:TOPICS]\n    if shown:\n        lines.append('Existing topics: ' + ', '.join(shown) + '.')\n    when = str(occurred_at or '')[:16].replace('T', ' ')\n    return {'envelope': note_envelope(), 'header': 'About this note (not part of its text): ' + str(note_id or '') + (', written ' + when + ' (now, for this note)' if when else '') + '.', 'title': clip(title, 200) if str(title or '').strip() else '(none)', 'text': str(text or '').rstrip(), 'context': '\\n'.join(lines) if lines else 'Nothing related is saved yet.'}\nreturn {\"packet\": filing_packet(note_id, occurred_at, title, text, similar, revisits, topics)}\n"
      }
    },
